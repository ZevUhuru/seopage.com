# ─────────────────────────────────────────────────────────────
# SEOPage MVP — environment
# Copy this file to .env.local and fill in your own keys.
# Never commit .env.local (it's gitignored).
# ─────────────────────────────────────────────────────────────

# Anthropic — powers the generation pipeline (Claude Opus 4.8).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — hosted Checkout for the $99 pay-first order (and legacy preview unlock).
# Test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From your webhook endpoint (optional locally — see README). Use `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — transactional email (order confirmation, operator alert, delivery).
# Optional: without it, emails are skipped (logged) and orders are fulfilled
# by hand from /admin. Domain must be verified in Resend before going live.
RESEND_API_KEY=re_...
# From address for all outgoing mail (must be on the verified domain).
EMAIL_FROM="SEOPage <pages@seopage.com>"
# Where "new paid order" alerts go (your inbox).
ORDER_ALERT_TO=you@example.com

# ── /agentic articles (headless, from api.esy.com) ──────────────
# Publication authored in compose.esy.com and read by seopage.com/agentic.
ESY_API_URL=https://api.esy.com
ESY_PUBLICATION_SLUG=seopage
# Shared secret for the publish/unpublish webhook -> /api/revalidate.
# HMAC (Standard Webhooks headers) is preferred; Bearer is the fallback.
# Per-publication override: ESY_REVALIDATE_SECRET_SEOPAGE
ESY_REVALIDATE_SECRET=

# Public origin used to build Stripe redirect URLs.
# Local: http://localhost:3000   Prod: https://seopage.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Shared store for generations (REQUIRED in production on Vercel — serverless
# instances don't share memory). Provision via Vercel → Storage → Upstash (Redis);
# it auto-injects these. Locally you can leave them blank (a temp-file fallback runs).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin order/intake lookup at /admin?key=<this>. Use a long random string.
# Leave unset to keep the page locked (it fails closed).
ADMIN_TOKEN=

